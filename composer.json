{
  "name": "wexample/symfony-remote-sparql",
  "description": "SPARQL endpoints (Wikidata's query service by default) as symfony-remotes: SELECT queries read as plain rows",
  "version": "1.0.1",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyRemoteSparql\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyRemoteSparql\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-helpers": ">=19.3.0",
    "wexample/symfony-remote": ">=2.2.0",
    "wexample/php-remote": ">=2.0.2",
    "symfony/http-client": ">=7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}
